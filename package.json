{
  "name": "semo-plugin-hello-world",
  "version": "2.0.2",
  "description": "Say something to the world and yourself everyday.",
  "repository": {
    "type": "git",
    "url": "https://github.com/semojs/semo-plugin-hello-world.git"
  },
  "keywords": [
    "semo",
    "cli",
    "demo"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "devDependencies": {
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.15.3",
    "@types/shelljs": "^0.8.15",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vitest/coverage-v8": "^3.1.2",
    "@vitest/eslint-plugin": "^1.1.44",
    "@vitest/ui": "^3.1.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "vitest": "^3.1.2"
  },
  "scripts": {
    "dev": "tsc -w",
    "build": "tsc",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "postversion": "git push && git push --tags",
    "prepublish": "npm run clean && npm run build",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest ",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js}\"",
    "format:check": "prettier --check \"**/*.{ts,js}\"",
    "deploy": "npm version patch",
    "deploy:minor": "npm version minor",
    "deploy:major": "npm version major"
  },
  "dependencies": {
    "@semo/core": "^2.0.7",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "dayjs": "^1.11.13",
    "lodash": "^4.17.21",
    "shelljs": "^0.9.2",
    "yaml": "^2.7.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
